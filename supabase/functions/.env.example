# Local Edge Function development only. Copy to .env, which is gitignored.
# Hosted Supabase functions receive Supabase credentials automatically.
APP_URL=http://127.0.0.1:5173
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nreplace-with-development-key-material\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=replace-with-your-local-server-secret-key
